# FoundU — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# ── Backend ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (includes credentials)
# Example: postgresql://user:password@localhost:5432/foundu
DATABASE_URL=postgresql://user:password@localhost:5432/foundu

# JWT signing key — must be a cryptographically random string (32+ chars)
# Generate: openssl rand -hex 32
JWT_SECRET=replace_with_random_secret

# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ── Matching Microservice ─────────────────────────────────────────────────────

# Internal URL the Node.js backend uses to reach the Python matching service
MATCHING_SERVICE_URL=http://localhost:8000

# ── Spotify (optional — music metadata enrichment) ───────────────────────────
# Server-side only. Never expose to mobile client.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Apple Push Notification Service ──────────────────────────────────────────
# APNs auth key content (p8 file contents, not the file path)
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.foundu.app
# Set to "true" for production APNs endpoint, "false" for sandbox
APNS_PRODUCTION=false

# ── SMS Verification (TBD provider — stub for now) ───────────────────────────
# TODO: TBD — confirm SMS provider before Milestone 2
SMS_PROVIDER_API_KEY=

# ── Venue Seeding (pre-launch only — not needed at runtime) ──────────────────
GOOGLE_PLACES_API_KEY=
FOURSQUARE_API_KEY=
